{
    "name": "backend",
    "version": "1.0.0",
    "description": "TypeScript backend with Discord bot functionality",
    "main": "dist/src/main.js",
    "type": "module",
    "scripts": {
        "predev": "docker compose -f docker-compose.db.yaml up -d",
        "dev": "tsx watch src/main.ts",
        "build": "tsc && tsc-alias -p tsconfig.json --resolve-full-extension .js",
        "start": "node dist/src/main.js",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:integration:audio": "vitest run tests/integration/audio",
        "test:integration:discord": "vitest run tests/integration/messagesAndReactions",
        "test:ci": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,json}\" \"tests/**/*.{ts,tsx,js,json}\" && eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json}\" \"tests/**/*.{ts,tsx,js,json}\"",
        "db:setup": "tsx scripts/setup-database.ts",
        "db:generate": "tsx scripts/generate-types.ts",
        "db:migrate": "tsx scripts/run-migrations.ts",
        "db:migrate:rollback": "tsx scripts/rollback-migrations.ts",
        "db:migrate:clear": "tsx scripts/clear-migration-state.ts",
        "docker:up": "docker compose -f compose.yaml up --build",
        "docker:up:detached": "docker compose -f compose.yaml up --build -d",
        "docker:down": "docker compose -f compose.yaml down",
        "docker:down:volumes": "docker compose -f compose.yaml down -v",
        "docker:up:dev": "docker compose -f docker-compose.dev.yaml up --build",
        "docker:up:detached:dev": "docker compose -f docker-compose.dev.yaml up --build -d",
        "docker:down:dev": "docker compose -f docker-compose.dev.yaml down",
        "docker:down:volumes:dev": "docker compose -f docker-compose.dev.yaml down -v",
        "docker:logs": "docker compose -f docker-compose.dev.yaml logs -f",
        "docker:restart": "docker compose -f docker-compose.dev.yaml restart",
        "docker:clean": "docker compose -f docker-compose.dev.yaml down -v --remove-orphans && docker system prune -f"
    },
    "dependencies": {
        "@discordjs/opus": "^0.10.0",
        "@discordjs/voice": "^0.19.2",
        "@dotenvx/dotenvx": "^1.51.4",
        "@google/genai": "^2.15.0",
        "commander": "^15.0.0",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "discord.js": "^14.27.0",
        "fast-deep-equal": "^3.1.3",
        "fastest-levenshtein": "^1.0.16",
        "fluent-ffmpeg": "^2.1.3",
        "helmet": "^8.3.0",
        "kysely": "^0.29.4",
        "kysely-codegen": "^0.20.0",
        "libsodium": "^0.8.4",
        "mime": "^4.1.0",
        "opusscript": "^0.1.1",
        "p-retry": "^8.0.0",
        "pg": "^8.22.0",
        "sodium-native": "^5.1.0",
        "xxhash-wasm": "^1.1.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@snazzah/davey": "^0.1.12",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/fluent-ffmpeg": "^2.1.28",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.3",
        "nodemon": "^3.1.14",
        "pg-mem": "^3.0.14",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.1",
        "tsx": "^4.23.1",
        "vitest": "^4.1.10"
    }
}
