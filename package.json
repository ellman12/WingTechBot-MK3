{
    "name": "wingtechbot-mk3-monorepo",
    "version": "1.0.0",
    "description": "WingTechBot MK3 monorepo",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm --filter backend dev",
        "build": "pnpm --recursive build",
        "test": "pnpm --recursive test",
        "test:unit": "pnpm --recursive test:unit",
        "test:integration": "vitest run tests/integration",
        "lint": "pnpm --recursive lint",
        "lint:fix": "pnpm --recursive lint:fix",
        "format": "pnpm --recursive format",
        "format:check": "pnpm --recursive format:check",
        "clean": "pnpm -r clean",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "eslint": "^10.9.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0"
    },
    "dependencies": {
        "date-fns": "^4.4.0"
    }
}
