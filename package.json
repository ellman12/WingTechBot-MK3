{
    "name": "wingtechbot-mk3-monorepo",
    "version": "1.0.0",
    "description": "WingTechBot MK3 monorepo",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm --filter backend dev",
        "build": "pnpm --recursive build",
        "test": "pnpm --recursive test",
        "test:unit": "pnpm --recursive test:unit",
        "test:integration": "vitest run tests/integration",
        "lint": "pnpm --recursive lint",
        "lint:fix": "pnpm --recursive lint:fix",
        "format": "pnpm --recursive format",
        "format:check": "pnpm --recursive format:check",
        "clean": "pnpm -r clean",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "typescript-eslint": "^8.65.0",
        "typescript": "^5.9.3"
    },
    "pnpm": {
        "overrides": {
            "jws": ">=4.0.1",
            "body-parser": ">=2.2.1",
            "qs": ">=6.14.1",
            "diff@<8.0.3": ">=8.0.3",
            "tar@<=7.5.2": ">=7.5.3"
        }
    }
}
